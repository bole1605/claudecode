# --- Supabase (Dashboard -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# "Publishable key" (frueher: anon key). Darf im Browser stehen, Schutz erfolgt per RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Single-User-Sperre (serverseitig) ---
# Nur diese E-Mail darf die App nutzen, selbst wenn versehentlich weitere Konten existieren.
ALLOWED_USER_EMAIL=du@example.com

# --- Ab spaeteren Meilensteinen (jetzt noch nicht noetig) ---
# SUPABASE_SERVICE_ROLE_KEY=      # NIEMALS NEXT_PUBLIC_, nur Server/Cron
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=
# CRON_SECRET=
