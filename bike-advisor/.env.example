# Kopiere diese Datei nach .env (wird NICHT eingecheckt). Schlüssel nur serverseitig!
PORT=3000
# Aktiviert den Web-Such-Provider (Claude API mit Websuche) und den KI-Berater
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-Tool für die Websuche (bei neueren API-Versionen ggf. anpassen)
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305
# Max. API-Anfragen pro Suche (Kosten-/Dauerbegrenzung)
BIKE_SEARCH_MAX_REQUESTS=3
# Cache-Dauer für Suchergebnisse in Minuten
BIKE_CACHE_TTL_MIN=360

# --- Kostenlose Recherche auf Websites (data/sources.json), kein API-Key nötig ---
BIKE_SITE_DELAY_MS=1200
# --- Zugriff vom Handy/Tablet im Heimnetz: HOST=0.0.0.0 und unbedingt eine PIN setzen ---
HOST=127.0.0.1
APP_PIN=
